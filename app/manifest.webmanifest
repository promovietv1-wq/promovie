{
  "id": "/app/",
  "name": "PromoVie",
  "short_name": "PromoVie",
  "description": "Aplicativo PromoVie: saúde biopsicossocial, telemedicina e autocuidado.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "/app/inicio/",
  "scope": "/app/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    {
      "src": "/app/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/app/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Telemedicina PromoVie",
      "short_name": "Telemedicina",
      "description": "Acessar o portal de telemedicina",
      "url": "/app/telemedicina/",
      "icons": [
        {
          "src": "/app/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "prefer_related_applications": false
}
