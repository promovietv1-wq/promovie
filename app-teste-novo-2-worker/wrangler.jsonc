{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promovie-mediquo-teste-2",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-20",
  // Domínio backend.promovie.tv.br já conectado pelo painel da Cloudflare.
  // Não alterar o vínculo do domínio por este arquivo.
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://www.promovie.tv.br,https://promovie.tv.br",
    "MEDIQUO_TEST_PATIENT_CODE": "promovie-homologacao-001",
    "TELESAUDE_V3_ENABLED": "false",
    "WIDGET_ENVIRONMENT": "sandbox"
  }
}
