{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promovie-mediquo-teste-2",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-20",
  "keep_vars": true,
  // O dominio backend.promovie.tv.br ja esta conectado na Cloudflare.
  // Preservar o DNS, o Worker antigo e os registros existentes.
  "d1_databases": [
    {
      "binding": "PROMOVIE_BENEFICIARIOS_DB",
      "database_name": "promovie-beneficiarios",
      "database_id": "a11f2e06-28c2-4582-ba40-7a3c7f43af4a"
    }
  ],
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://www.promovie.tv.br,https://promovie.tv.br",
    "PROMOVIE_BENEFICIARY_ACCESS_ENABLED": "true",
    // Cofre pessoal isolado. Conteúdo de saúde cifrado no navegador com consentimento específico.
    "PROMOVIE_SPACE_ENABLED": "true",
    // Diretório somente-leitura: ativado exclusivamente com login de teste autorizado.
    "PROMOVIE_DIRECTORY_ENABLED": "true",
    "MEDIQUO_TEST_PATIENT_CODE": "promovie-homologacao-001",
    // Controles de escrita, atendimento e múltiplos beneficiários permanecem no painel Cloudflare.
    // keep_vars evita apagar valores configurados durante atualizações do código.
    // Pedro confirmou production para o Widget, mesmo em homologacao.
    "WIDGET_ENVIRONMENT": "production",
    "MEDIQUO_V3_PLAN": "345",
    "MEDIQUO_V3_ORIGIN": "SDK",
    "MEDIQUO_V3_BASE_URL": "https://sdk.mediquo.com/v1",
    // Chave PUBLICA do Widget enviada no kit V3 pelo fornecedor.
    "MEDIQUO_V3_WIDGET_API_KEY": "HkmxlRZzJ00SlB8U",
    "MEDIQUO_V3_ID_BASE_URL": "https://api-portal.mediquo.com.br",
    // Autenticacao SDK V3 em modo CPF conforme kit do fornecedor, nao migrar para API ID.
    "MEDIQUO_V3_SDK_AUTH_MODE": "cpf"
  }
}
