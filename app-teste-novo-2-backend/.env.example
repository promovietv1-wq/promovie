# Somente exemplo! O arquivo .env com valores reais é privado.
# Configure as variáveis reais no serviço de hospedagem do backend.
PORT=3000
ALLOWED_ORIGINS=https://www.promovie.tv.br,https://promovie.tv.br
MEDIQUO_API_KEY=INSIRA_A_API_KEY_DE_STAGING
MEDIQUO_SECRET_KEY=INSIRA_A_SECRET_KEY_PRIVADA
# Senha longa, exclusiva, aleatória (mínimo 16 caracteres); não publicar.
PROMOVIE_TEST_PASSWORD=INSIRA_UMA_SENHA_DE_TESTE_FORTE
# Um único cadastro fictício, exclusivo de homologação.
MEDIQUO_TEST_PATIENT_CODE=promovie-homologacao-001
# Opcional: confirmar com Pedro se a API de Staging possui outro endpoint.
MEDIQUO_BASE_URL=https://sdk.mediquo.com/v1
# MEDIQUO_TEST_PLAN=
